{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "DocsOps Metadata Decision Output",
    "description": "Decision output schema for RTCDP metadata detection and enforcement (MVP).",
    "type": "object",
    "required": [
        "file_path",
        "current_features",
        "signals_matched",
        "evidence",
        "proposed_features",
        "confidence",
        "decision"
    ],
    "properties": {
        "file_path": {
            "type": "string",
            "description": "Relative path to the documentation file being evaluated."
        },
        "current_features": {
            "type": "array",
            "description": "Existing metadata features applied to the file.",
            "items": {
                "type": "string"
            }
        },
        "signals_matched": {
            "type": "array",
            "description": "Hard signals detected in the content.",
            "items": {
                "type": "object",
                "required": [
                    "rule_id",
                    "signal_type",
                    "match_pattern",
                    "weight"
                ],
                "properties": {
                    "rule_id": {
                        "type": "string",
                        "description": "Unique identifier of the hard-signal rule."
                    },
                    "signal_type": {
                        "type": "string",
                        "enum": [
                            "explicit_string",
                            "feature_name",
                            "entitlement_phrase"
                        ],
                        "description": "Classification of the detected signal."
                    },
                    "match_pattern": {
                        "type": "string",
                        "description": "Exact string or pattern that triggered the signal."
                    },
                    "weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Confidence weight assigned to this signal."
                    }
                }
            }
        },
        "evidence": {
            "type": "array",
            "description": "Human-verifiable evidence supporting detected signals.",
            "items": {
                "type": "object",
                "required": [
                    "snippet",
                    "line_number"
                ],
                "properties": {
                    "snippet": {
                        "type": "string",
                        "description": "Exact text excerpt from the document."
                    },
                    "line_number": {
                        "type": "integer",
                        "description": "Line number where the snippet was found."
                    }
                }
            }
        },
        "proposed_features": {
            "type": "array",
            "description": "Metadata features proposed for addition (never removals).",
            "items": {
                "type": "string"
            }
        },
        "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Aggregate confidence score derived from weighted hard signals."
        },
        "decision": {
            "type": "string",
            "enum": [
                "add",
                "review",
                "ignore"
            ],
            "description": "System recommendation based on confidence thresholds and contract rules."
        },
        "decision_rationale": {
            "type": "string",
            "description": "Deterministic, machine-generated explanation for the decision."
        },
        "constraints_violated": {
            "type": "array",
            "description": "Optional list of taxonomy contract constraints that block auto-add.",
            "items": {
                "type": "string"
            }
        }
    }
}
